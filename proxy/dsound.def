; The co-op proxy is dsound.dll. The ordinals are the system dsound.dll's: the game imports DirectSoundEnumerateA (2) and
; DirectSoundCreate8 (11) by ordinal, so they must not move (tools/test_build_gate.sh checks the table).
LIBRARY dsound
EXPORTS
    DirectSoundCreate @1
    DirectSoundEnumerateA @2
    DirectSoundEnumerateW @3
    DllCanUnloadNow @4 PRIVATE
    DllGetClassObject @5 PRIVATE
    DirectSoundCaptureCreate @6
    DirectSoundCaptureEnumerateA @7
    DirectSoundCaptureEnumerateW @8
    GetDeviceID @9
    DirectSoundFullDuplexCreate @10
    DirectSoundCreate8 @11
    DirectSoundCaptureCreate8 @12
