// Config name, Cfg member, default key, guide description, launcher label.
// Shared co-op keys (same default in every co-op mod): chat T, ping V or middle mouse, push to talk B or the mouse side button, emote wheel H (hold),
// player list Tab (hold, fixed), watch [ ] (fixed). A key code below 0x08 is a mouse input: 4 middle button, 5 side button 1, 6 side button 2, 7 wheel (common/guide.h).
BIND("key_chat", keyChat, 'T', "Chat (Enter sends, Esc cancels)", "Chat")
BIND("key_ping", keyPing, 'V', "Ping what you are looking at", "Ping a place")
BIND("key_ping_alt", keyPingAlt, 4, "Ping what you are looking at", "Ping a place (second key)")
BIND("key_emote", keyEmote, 'H', "Hold: emote wheel (Tab: next page)", "Emote wheel (hold)")
BIND("key_draw", keyDraw, 'X', "Hold: draw on the world (Shift: clear yours)", "Draw (hold)")
BIND("key_canvas", keyCanvas, 'Z', "Drawing canvas (Backspace undoes)", "Drawing canvas")
BIND("key_color", keyColor, 7, "Ink colour while drawing", "Ink colour")
BIND("key_voice", keyVoice, 'B', "Hold: push to talk", "Push to talk")
BIND("key_voice_alt", keyVoiceAlt, 5, "Hold: push to talk", "Push to talk (second key)")
BIND("key_voice_channel", keyVoiceChannel, 'Y', "Next voice channel", "Next voice channel")
BIND("key_radio", keyRadio, 'R', "Hold: talk on the radio", "Radio (hold)")
BIND("key_tv_deploy", keyTvDeploy, 'J', "Put up / take down the sky TV of the player you aim at", "Deploy / retract sky TV")
BIND("key_tv_seat", keyTvSeat, 'K', "Sit on / leave the audience stool you aim at", "Audience seat / stand")
