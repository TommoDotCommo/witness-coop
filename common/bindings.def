// Config name, Cfg member, default key, guide description, launcher label.
// Shared co-op keys (same default in every co-op mod): chat T, ping V or middle mouse, push to talk B or the mouse side button, emote wheel H (hold),
// player list Tab (hold, fixed), watch [ ] (fixed). A key code below 0x08 is a mouse input: 4 middle button, 5 side button 1, 6 side button 2, 7 wheel (common/guide.h).
BIND("key_chat", keyChat, 'T', "Chat; Enter sends, Esc cancels", "Chat")
BIND("key_ping", keyPing, 'V', "Ping the point under the crosshair", "Ping a place")
BIND("key_ping_alt", keyPingAlt, 4, "Ping the point under the crosshair (second key)", "Ping a place (second key)")
BIND("key_emote", keyEmote, 'H', "Hold: emote wheel; move mouse, release", "Emote wheel (hold)")
BIND("key_draw", keyDraw, 'X', "Hold: draw; Shift + key clears your ink", "Draw (hold)")
BIND("key_canvas", keyCanvas, 'Z', "Toggle drawing canvas; Backspace undoes", "Drawing canvas")
BIND("key_color", keyColor, 7, "Next ink colour while drawing (wheel: scroll up / down)", "Ink colour")
BIND("key_voice", keyVoice, 'B', "Hold: push to talk (when PTT enabled)", "Push to talk")
BIND("key_voice_alt", keyVoiceAlt, 5, "Hold: push to talk (second key)", "Push to talk (second key)")
BIND("key_voice_channel", keyVoiceChannel, 'Y', "Next voice channel / direct recipient", "Next voice channel")
BIND("key_radio", keyRadio, 'R', "Hold: radio channel (walkie-talkie)", "Radio (hold)")
BIND("key_tv_deploy", keyTvDeploy, 'J', "Deploy aimed player's sky TV; again retracts", "Deploy / retract sky TV")
BIND("key_tv_seat", keyTvSeat, 'K', "Aim at an audience stool: sit / stand; movement exits", "Audience seat / stand")
